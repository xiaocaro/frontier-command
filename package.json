{
  "name": "frontier-command",
  "version": "1.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Frontier Command — Lv1 + Lv2 deterministic frontier ecology",
  "author": "Frontier Command Project",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/create-icon.mjs && tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:llm": "vitest run tests/agent/live-deepseek.test.ts",
    "demo:live": "node scripts/demo-live.mjs",
    "demo:ui": "npm run build && playwright test --config playwright.demo.config.ts",
    "format": "prettier --write src electron scripts tests *.json *.ts index.html",
    "test:e2e": "npm run build && playwright test",
    "test:package": "node scripts/smoke-package.mjs",
    "package": "npm run build && electron-builder --win --dir",
    "package:zip": "node scripts/package-zip.mjs",
    "test:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "org.frontiercommand.desktop",
    "productName": "Frontier Command",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json",
      "docs/**/*",
      "prompts/**/*",
      "schemas/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "extraFiles": [
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ]
  }
}
